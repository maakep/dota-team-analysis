{
  "name": "dota-scout",
  "version": "0.3.0",
  "private": true,
  "description": "Counter-draft intel dashboard for an amateur Dota team. Static Next.js app; data is fetched from STRATZ at build time and baked into the bundle.",
  "scripts": {
    "prefetch": "tsx scripts/prefetch.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "npm run prefetch && next dev",
    "lint": "next lint",
    "format": "prettier --write .",
    "refresh": "npm run prefetch && git add data/team.json && git commit -m \"data: refresh team.json\" && git push"
  },
  "dependencies": {
    "next": "14.2.13",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.13",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  }
}
