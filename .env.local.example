# STRATZ API JWT (https://stratz.com/api). Server-side only — never expose in client code.
STRATZ_TOKEN=

# Numeric STRATZ team id (the team you want to scout).
TEAM_ID=9200913

# Optional tuning knobs. All have sane defaults baked into
# lib/fetch-team-data.ts; uncomment to override.
#
# Days of team-scrim history to analyze (default 270).
# TEAM_WINDOW_DAYS=270
# Days of pub history to analyze (default 270, synced with the team window
# so the roster overview can present one combined volume number).
# PUB_WINDOW_DAYS=270
# Minimum games to surface a (hero, position) ban card (defaults 3 / 5).
# BAN_MIN_GAMES_TEAM=3
# BAN_MIN_GAMES_PUB=5
# Minimum team games for the top-priority bans list (default 3).
# TOP_BAN_MIN_GAMES=3

# Optional: subpath the site is served under. Leave empty for local dev;
# the GitHub Actions workflow sets this to "/dota-team-analysis".
# BASE_PATH=
